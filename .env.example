# ---------------------------------------------------------------------------
# Bakenye Unity and Development SACCO - environment
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS - used exclusively by admin actions that must
# create auth users (member onboarding, staff provisioning). NEVER expose this
# to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------

# The address this deployment is served from, with no trailing slash. It is the
# canonical URL in every page's metadata, the base of the sitemap, and the
# origin of password-reset links.
#
# Set it to https://bakenye-sacco.online in production. Leave it unset on a
# preview deployment: the site then describes itself honestly, and robots.txt
# and the sitemap deliberately keep that preview out of Google so it cannot
# compete with the real site for the SACCO's own name.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console site verification.
#
# Paste the token from the "HTML tag" verification method - only the value of
# the tag's `content` attribute, not the whole tag. Leaving it empty renders no
# verification tag at all, which is correct: a placeholder token verifies
# nothing. Verification can also be done by DNS, in which case leave this unset.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
