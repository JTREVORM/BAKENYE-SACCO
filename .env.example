# ---------------------------------------------------------------------------
# Bakenye National Development SACCO - environment
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS - used exclusively by admin actions that must
# create auth users (member onboarding, staff provisioning). NEVER expose this
# to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used to build password-reset redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
